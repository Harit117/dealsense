      "position": [
        220,
        0
      ],
      "parameters": {
        "jsCode": "// Portals, WhatsApp Business, Gmail and Google Forms all post different shapes.\nreturn $input.all().map(item => {\n  const body = item.json.body || {};\n  const source = body.source || (item.json.query || {}).source || 'n8n';\n  const text = body.text || body.message || body.body || body.enquiry || body.snippet || '';\n  return { json: { source, payload: { ...body, text } } };\n});"
      }
    },
    {
      "id": "aad79de4-a395-5178-b57f-71ac4ffc920e",
      "name": "DealSense: extract, de-dup, match, score",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        460,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.DEALSENSE_URL || 'http://localhost:8000' }}/api/webhooks/{{ $json.source }}",
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.payload) }}"
      }
    },
    {
      "id": "b0e771ab-8eab-5dfe-8e4b-768cbf937aed",
      "name": "Summarise result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        700,
        0
      ],
      "parameters": {
        "jsCode": "const r = $input.first().json;\nconst best = (r.top_matches || [])[0];\nreturn [{ json: {\n  lead: r.lead.name, deduplicated: r.deduplicated, extraction: r.extraction,\n  best_match: best ? `${best.property_label} (${Math.round(best.score)})` : null,\n  route: best ? best.route : 'nurture', actions: r.actions,\n}}];"
      }
    },
    {
