      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        240,
        0
      ],
      "parameters": {
        "mode": "expression",
        "numberOutputs": 3,
        "output": "={{ $json.body.score >= 80 ? 0 : ($json.body.score >= 50 ? 1 : 2) }}"
      }
    },
    {
      "id": "14ccf66d-ea30-55eb-a7c0-9e7d956d6d98",
      "name": "Format hot-deal alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        -180
      ],
      "parameters": {
        "jsCode": "const d = $input.first().json.body;\nconst text = `🔥 ${d.title}\\n${d.message}\\n\\nCall ${d.lead.name}: ${d.lead.phone || 'n/a'}`;\nreturn [{ json: { ...d, text } }];"
      }
    },
    {
      "id": "cf4d8550-1b5c-5de2-a4f1-24113a6c6ebb",
      "name": "Instant alert to broker (Telegram)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        760,
        -180
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/sendMessage",
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $env.TELEGRAM_CHAT_ID, text: $json.text }) }}"
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "4fa35e0d-1108-5dc0-930d-eed2ac570558",
